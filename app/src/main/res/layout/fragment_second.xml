<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nested_scroll_view_2nd_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp">
        <!-- original padding: 16dp -->

        <Button
            android:id="@+id/button_second"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/command_previous"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/img_view_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <RelativeLayout
            android:id="@+id/rel_layout_point_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginLeft="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="15dp"
            android:background="@color/light_blue"
            android:visibility="gone" >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:orientation="vertical" >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:id="@+id/txt_view_caption_add_point"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_add_point"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <!-- Dummy EditText to avoid unwanted focus on other EditText: -->
                    <EditText
                        android:id="@+id/edit_text_dummy"
                        android:layout_width="1dp"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:inputType="none" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="x:"
                        android:textSize="20sp"
                        android:textStyle="normal"/>
                    <EditText
                        android:id="@+id/edit_text_x_value"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:textSize="20sp"
                        android:digits="0123456789"
                        android:maxLength="2"
                        android:inputType="number" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="y:"
                        android:textSize="20sp"
                        android:textStyle="normal" />
                    <EditText
                        android:id="@+id/edit_text_y_value"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:textSize="20sp"
                        android:digits="0123456789"
                        android:maxLength="2"
                        android:inputType="number" />
                    <SeekBar
                        android:id="@+id/seek_bar_value"
                        android:layout_width="145dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="z:"
                        android:textSize="20sp"
                        android:textStyle="normal" />
                    <EditText
                        android:id="@+id/edit_text_z_value"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:textSize="20sp"
                        android:digits="0123456789"
                        android:maxLength="2"
                        android:inputType="number" />
                    <Button
                        android:id="@+id/button_add_point"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20sp"
                        android:text="@string/command_add" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rel_layout_axis_angles_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginLeft="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="15dp"
            android:background="@color/light_blue"
            android:visibility="gone" >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:orientation="vertical" >

                <LinearLayout
                    android:id="@+id/linear_layout_axis_angles_input_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintVertical_chainStyle="spread"
                    app:layout_constraintHorizontal_chainStyle="spread" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_set_axis_angles"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <!-- Dummy EditText to avoid unwanted focus on other EditText: -->
                    <EditText
                        android:id="@+id/edit_text_dummy_2"
                        android:layout_width="1dp"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:inputType="none" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/linear_layout_edit_fields"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linear_layout_axis_angles_input_headline"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:orientation="vertical" >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="x:"
                            android:textSize="20sp"
                            android:textStyle="normal"/>
                        <EditText
                            android:id="@+id/edit_text_x_axis_angle"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:textSize="20sp"
                            android:digits="0123456789"
                            android:maxLength="3"
                            android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="y:"
                            android:textSize="20sp"
                            android:textStyle="normal" />
                        <EditText
                            android:id="@+id/edit_text_y_axis_angle"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:textSize="20sp"
                            android:digits="0123456789"
                            android:maxLength="3"
                            android:inputType="number" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="z:"
                            android:textSize="20sp"
                            android:textStyle="normal" />
                        <EditText
                            android:id="@+id/edit_text_z_axis_angle"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:textSize="20sp"
                            android:digits="0123456789"
                            android:maxLength="3"
                            android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rel_layout_angle_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linear_layout_axis_angles_input_headline"
                    app:layout_constraintBottom_toTopOf="@id/button_set_axis_angles"
                    android:visibility="visible" >
                    <ImageButton
                        android:id="@+id/img_button_angle_indicator"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/symbol_circle_quartered"
                        android:scaleType="fitXY"
                        app:tint="@color/material_purple"
                        android:background="#00000000" />
                    <ImageView
                        android:id="@+id/img_view_point_angle_indicator"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/symbol_circle_filled"
                        app:tint="#FFFF0000" />
                </RelativeLayout>
                <Button
                    android:id="@+id/button_set_axis_angles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:layout_marginRight="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/command_set_axis_angles"
                    android:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rel_layout_edge_input_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginLeft="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="15dp"
            android:background="@color/light_blue"
            android:visibility="gone" >
            <TextView
                android:id="@+id/txt_view_edge_input_instruction"
                android:maxWidth="200dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:text="@string/instruction_add_edge"
                android:textStyle="bold"
                android:textAlignment="center"
                android:gravity="center_horizontal" />
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/linear_layout_edge_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">
            <Button
                android:id="@+id/button_point1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/black"
                android:text="@string/point" />
            <Button
                android:id="@+id/button_point2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginStart="5dp"
                android:backgroundTint="@color/black"
                android:text="@string/point" />
            <Button
                android:id="@+id/button_point3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginStart="5dp"
                android:backgroundTint="@color/black"
                android:text="@string/point" />
        </LinearLayout>
        <ImageView
            android:id="@+id/img_view_point"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/symbol_circle_filled"
            android:visibility="gone" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>